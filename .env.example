# Copy to `.env` and fill in your own keys:
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed. The real environment always
# wins over this file, so `ALCHEMY_KEY=... python3 kit.py ...` overrides it.
#
# All three are optional. Keyless public RPCs cover single-tx reads, balances,
# code checks and basic Solana. See README.md for what each key unlocks.

# Alchemy: full transfer history, token balances, prices. Free 30M CU/month.
# https://dashboard.alchemy.com/
ALCHEMY_KEY=

# Etherscan V2: explorer-verified history, contract source, labels.
# Free 100k calls/day. https://etherscan.io/myapikey
ETHERSCAN_KEY=

# Helius: parsed Solana transactions. Free 1M credits/month.
# https://dashboard.helius.dev/
HELIUS_KEY=
